alphabets=['a','b','c','d','e','f','g','h','i','j','k','l','m','n','o','p','q','r','s','t','u','v','w','x','y','z']
def encrypt(plain,shift):#divya
    cipher_text=""
    for ch in plain:
        if ch in alphabets:
            index_find=alphabets.index(ch)
            xyz=(index_find+shift)%26 #without %26 it gets out of range, this will limit till 25 
            cipher_text+=alphabets[xyz]
        else:
            cipher_text+=ch
    print(f"here is the encrpyted form={cipher_text}")        
           

def decrypt(cipher,shift):
    plain_text=""
    for ch in cipher:
        if ch in alphabets:
            index_find=alphabets.index(ch)
            xyz=(index_find-shift)%26 #without %26 it gets out of range, this will limit till 25 
            plain_text+=alphabets[xyz]
        else:
            plain_text+=ch
    print(f"here is the decrpyted form={plain_text}") 
       
