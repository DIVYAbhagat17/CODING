n = int(input())
lines = []
for i in range(n):
    lines.append(input())

for i in range(0, n, 2):
    if i + 1 < n:
        first = lines[i]
        second = lines[i + 1]

        # After swapping: second comes first
        # Output position is odd (1st, 3rd, ...)
        print(second[::-1])
        print(first)
    else:
        # Last line if n is odd
        print(lines[i][::-1])
