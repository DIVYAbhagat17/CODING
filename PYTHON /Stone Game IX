class Solution(object):
    def stoneGameIX(self, stones):
        cnt = [0, 0, 0]
        for x in stones:
            cnt[x % 3] += 1
        if cnt[1] == 0 and cnt[2] == 0:
            return False
        if cnt[0] % 2 == 0:
            return cnt[1] >= 1 and cnt[2] >= 1 and abs(cnt[1] - cnt[2]) <= 2
        return (cnt[1] >= 1 and cnt[2] >= 3) or \
               (cnt[2] >= 1 and cnt[1] >= 3)
