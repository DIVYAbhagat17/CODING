class Solution:
    def findKthSmallest(self, coins, k):

        def gcd(a, b):
            while b:
                a, b = b, a % b
            return a

        def lcm(a, b):
            return (a // gcd(a, b)) * b

        n = len(coins)

        # Precompute LCM for every subset
        subsets = []

        for mask in range(1, 1 << n):
            cur = 1
            bits = 0

            for i in range(n):
                if mask & (1 << i):
                    cur = lcm(cur, coins[i])
                    bits += 1

            subsets.append((cur, bits))

        def count(x):
            total = 0

            for cur, bits in subsets:
                if cur > x:
                    continue

                if bits % 2 == 1:
                    total += x // cur
                else:
                    total -= x // cur

            return total

        left = 1
        right = min(coins) * k

        while left < right:
            mid = (left + right) // 2

            if count(mid) >= k:
                right = mid
            else:
                left = mid + 1

        return left
