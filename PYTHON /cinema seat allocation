class Solution(object):
    def maxNumberOfFamilies(self, n, reservedSeats):
        """
        :type n: int
        :type reservedSeats: List[List[int]]
        :rtype: int
        """

        # Store reserved seats for each row
        rows = {}

        for row, seat in reservedSeats:
            if row not in rows:
                rows[row] = set()
            rows[row].add(seat)

        # All rows without reservations can accommodate 2 groups
        ans = (n - len(rows)) * 2

        # Check rows having reservations
        for seats in rows.values():

            left = {2, 3, 4, 5}
            middle = {4, 5, 6, 7}
            right = {6, 7, 8, 9}

            if not (seats & left):
                # Left block is free
                if not (seats & right):
                    # Both left and right are free
                    ans += 2
                else:
                    ans += 1

            elif not (seats & middle):
                # Middle block is free
                ans += 1

            elif not (seats & right):
                # Right block is free
                ans += 1

        return ans
