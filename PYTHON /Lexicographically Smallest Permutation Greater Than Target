class Solution:
    def lexGreaterPermutation(self, s, target):
        count = [0] * 26

        for ch in s:
            count[ord(ch) - ord('a')] += 1

        for i in range(len(target) - 1, -1, -1):
            temp = count[:]

            # Match target's prefix
            possible = True

            for j in range(i):
                idx = ord(target[j]) - ord('a')

                if temp[idx] == 0:
                    possible = False
                    break

                temp[idx] -= 1

            if not possible:
                continue

            # Find smallest character greater than target[i]
            curr = ord(target[i]) - ord('a')

            for c in range(curr + 1, 26):
                if temp[c] > 0:
                    temp[c] -= 1

                    ans = target[:i] + chr(c + ord('a'))

                    # Add remaining characters in sorted order
                    for k in range(26):
                        ans += chr(k + ord('a')) * temp[k]

                    return ans

        return ""
