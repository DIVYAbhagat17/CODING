import math

class PrimeChecker:
    def __init__(self, number: int):
        """Initializes the object with the number to be checked."""
        self.number = number

    def is_prime(self) -> bool:
        """Returns True if the number is prime, False otherwise."""
        # Numbers less than or equal to 1 are not prime
        if self.number <= 1:
            return False
        
        # 2 is the only even prime number
        if self.number == 2:
            return True
            
        # Exclude all other even numbers
        if self.number % 2 == 0:
            return False

        # Check odd factors up to the square root of the number
        max_divisor = int(math.isqrt(self.number))
        for i in range(3, max_divisor + 1, 2):
            if self.number % i == 0:
                return False  # Factor found, not prime
                
        return True  # No factors found, it is prime

# --- Example Usage ---
if __name__ == "__main__":
    # Test case 1: Checking a single number
    num1 = 29
    checker1 = PrimeChecker(num1)
    if checker1.is_prime():
        print(f"✅ {num1} is a prime number.")
    else:
        print(f"❌ {num1} is not a prime number.")

    # Test case 2: Checking another number from user input
    try:
        user_input = int(input("\nEnter a number to check: "))
        checker2 = PrimeChecker(user_input)
        
        if checker2.is_prime():
            print(f"✅ {user_input} is a prime number.")
        else:
            print(f"❌ {user_input} is not a prime number.")
    except ValueError:
        print("Please enter a valid integer.")
