class Solution:
    def stoneGameV(self, stoneValue):
        n = len(stoneValue)

        # Prefix sums
        prefix = [0] * (n + 1)

        for i in range(n):
            prefix[i + 1] = prefix[i] + stoneValue[i]

        # dp[l][r] = maximum score for subarray l...r
        dp = [[0] * n for _ in range(n)]

        # Length 2, then 3, ..., n
        for length in range(2, n + 1):
            for l in range(n - length + 1):
                r = l + length - 1

                for k in range(l, r):
                    left = prefix[k + 1] - prefix[l]
                    right = prefix[r + 1] - prefix[k + 1]

                    if left < right:
                        dp[l][r] = max(
                            dp[l][r],
                            left + dp[l][k]
                        )

                    elif left > right:
                        dp[l][r] = max(
                            dp[l][r],
                            right + dp[k + 1][r]
                        )

                    else:
                        dp[l][r] = max(
                            dp[l][r],
                            left + max(dp[l][k], dp[k + 1][r])
                        )

        return dp[0][n - 1]
