#include <iostream> 
using namespace std;
class Complex {    
float x;    
float y; 
public:    
Complex(){}  
Complex(float real, float imag)    
{      
x = real;   
y = imag;   
}    
Complex operator+(Complex c);    
void display();
};
Complex Complex::operator+(Complex c) { 
Complex temp;     
temp.x = x + c.x; 
temp.y = y + c.y;  
return temp;
}
void Complex::display()
{ 
cout << x << " + j" << y;
cout << endl;
} 
int main() {  
Complex c1(2.5, 3.5);   
Complex c2(1.5, 4.5); 
Complex c3;   
c3 = c1 + c2;   
cout << "C1 = ";   
c1.display();  
cout << "C2 = ";    
c2.display();   
cout << "C3 = ";    
c3.display();   
return 0;
} 
