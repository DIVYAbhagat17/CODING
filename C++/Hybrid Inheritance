#include <iostream>
using namespace std;

class Animal {
public:
    void eat() {
        cout << "Animal is eating" << endl;
    }
};

class Dog : public Animal {
public:
    void bark() {
        cout << "Dog is barking" << endl;
    }
};

class Cat : public Animal {
public:
    void meow() {
        cout << "Cat is meowing" << endl;
    }};
class Puppy : public Dog, public Cat {
public:
    void play() {
        cout << "Puppy is playing" << endl;
    }
};
int main() {
    Puppy p;
    p.bark();
    p.meow();
    p.play();
    return 0;
}
