#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter value of n: ";
    cin >> n;

    int sum = 0;

    // Using for loop
    for (int i = 1; i <= n; i++)
    {
        sum = sum + i;
    }

    cout << "The sum of first N natural numbers by for loop is: "
         << sum << endl;

    return 0;
}
