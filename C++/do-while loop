#include <iostream>
using namespace std;

int main()
{
    int n;

    cout << "Enter value of n: ";
    cin >> n;

    int sum = 0;
    int i = 1;

    // Using do-while loop
    do
    {
        sum = sum + i;
        i++;
    }
    while (i <= n);

    cout << "The sum of first N natural numbers by do-while loop is: "
         << sum << endl;

    return 0;
}
