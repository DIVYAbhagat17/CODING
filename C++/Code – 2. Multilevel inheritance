#include<iostream>
using namespace std;
class Animal{
	public:
		void eat(){
			cout<<"Eating"<<endl;
		}
};
class Mammal:public Animal{
	public:
		void walk(){
			cout<<"working"<<endl;
		}
};
class Dog:public Mammal{
	public:
		void bark(){
			cout<<"barking"<<endl;
		}
};
int main(){
	Dog d;
d.eat();
d.walk();
d.bark();
return 0;
}
