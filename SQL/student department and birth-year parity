    result = cur.fetchall()
    for row in  result:
        firstname=row[0]
        depname=row[1]
        date=row[2]
        year=date.year
        if year % 2==0:
            print(firstname+","+depname+",Even")
        else:
            print(firstname+","+depname+",Odd")

    

